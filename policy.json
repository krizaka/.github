{
  "$schema": "./docs/standards/policy.schema.json",
  "version": 1,
  "train": {
    "prCapPerLane": 5,
    "capScope": "lane-per-repository",
    "fixMainExempt": true
  },
  "observability": {
    "provider": "grafana-cloud",
    "dashboards": {
      "enforcement": "warn"
    },
    "environments": {
      "dev": {
        "state": "live",
        "console": "https://purplesturgeon2768.grafana.net"
      },
      "prod": {
        "state": "to-create"
      }
    }
  },
  "sonar": {
    "qualityGate": {
      "name": "Krizaka",
      "conditions": {
        "new_blocker_violations": {
          "op": "GT",
          "error": "0"
        },
        "new_bugs": {
          "op": "GT",
          "error": "0"
        },
        "new_critical_violations": {
          "op": "GT",
          "error": "0"
        },
        "new_duplicated_lines_density": {
          "op": "GT",
          "error": "3"
        },
        "new_major_violations": {
          "op": "GT",
          "error": "0"
        },
        "new_security_hotspots_reviewed": {
          "op": "LT",
          "error": "100"
        },
        "new_vulnerabilities": {
          "op": "GT",
          "error": "0"
        }
      }
    },
    "privateRepositoryProject": "private"
  }
}
