  "terms": [
    {
      "term": "orazaka",
      "replacement": "sovkora",
      "brand": "Sovkora",
      "detect": "orazaka",
      "forms": [
        {
          "kind": "java-package",
          "regex": "com\\.krizaka\\.orazaka(?![A-Za-z0-9])",
          "to": "com.krizaka.sovkora"
        },
        {
          "kind": "npm",
          "regex": "@krizaka/orazaka-",
          "to": "@krizaka/sovkora-"
        },
        {
          "kind": "repo-url",
          "regex": "krizaka/orazaka(?![A-Za-z0-9])",
          "to": "krizaka/sovkora",
          "resolve": "github"
        },
        {
          "kind": "env",
          "regex": "(?<![A-Za-z0-9])ORAZAKA_",
          "flags": "",
          "to": "sovkora_"
        },
        {
          "kind": "env",
          "regex": "_ORAZAKA(?=_|$)",
          "flags": "",
          "to": "_sovkora"
        },
        {
          "kind": "database",
          "regex": "orazaka(_[a-z]+)?_db(?![A-Za-z0-9])",
          "to": "sovkora$1_db"
        },
        {
          "kind": "database",
          "regex": "orazaka_app(?![A-Za-z0-9])",
          "to": "sovkora_app"
        },
        {
          "kind": "amqp",
          "regex": "orazaka[._](jobs|events|dlx)(?![A-Za-z0-9])",
          "to": "sovkora.$1"
        },
        {
          "kind": "capability",
          "regex": "orazaka\\.(core|validation|screening|automation|studio|photo|safety|message|identity|echo|code|data)\\.",
          "to": "sovkora.$1."
        },
        {
          "kind": "pack-schema",
          "regex": "orazaka\\.dev/",
          "to": "sovkora.dev/"
        },
        {
          "kind": "host",
          "regex": "(?<![A-Za-z0-9])((?:[a-z0-9-]+\\.)*)orazaka\\.com(?![A-Za-z0-9])",
          "to": "$1sovkora.com"
        },
        {
          "kind": "spring-key",
          "regex": "(?<![A-Za-z0-9-])orazaka\\.(?=[a-z])",
          "to": "sovkora."
        },
        {
          "kind": "table",
          "regex": "(?<![A-Za-z0-9])orazaka_(?=[a-z])",
          "to": "sovkora_"
        },
        {
          "kind": "header",
          "regex": "(?<=X-)orazaka-(?=[a-z])",
          "to": "sovkora-"
        },
        {
          "kind": "module",
          "regex": "(?<![A-Za-z0-9])orazaka-(?=[a-z])",
          "to": "sovkora-"
        },
        {
          "kind": "word",
          "regex": "(?<![A-Za-z0-9])orazaka(?![A-Za-z0-9])",
          "to": "sovkora"
        }
      ]
    },
