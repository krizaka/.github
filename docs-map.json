{
  "_": "Which documents a change of each kind must update (ADR-026, krizaka-internal#2734; docs/standards/docs-map.md explains the shape and how to add a category). `when` = the repository and the globs of the changed files that put a pull request in the category (globs, never regexes: `*` inside a folder, `**` across folders). `docs` = what the same pull request, or the one named in its « Docs: » line, must update. `bump` = a krizaka-agents skill, whose plugin version in .claude-plugin/marketplace.json moves with it. `local` = a page outside git (the cockpit): printed, never required. The local krizaka.config.json only points here (key `docsMap`).",
  "categories": [
    {
      "id": "way-of-working",
      "title": "Way of working: the agents' tools, skills, install and the org standards",
      "when": [
        { "repo": "krizaka-agents", "globs": ["tools/**", "skills/**", "subagents/**", "AGENTS.md", "install.sh"] },
        { "repo": ".github", "globs": ["docs/standards/**"] }
      ],
      "docs": [
        { "repo": "krizaka-internal", "path": "docs/onboarding/with-claude-code.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/with-claude-code.fr.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/without-claude-code.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/without-claude-code.fr.md" },
        { "repo": "krizaka-agents", "path": "README.md" },
        { "repo": "krizaka-agents", "path": "AGENTS.md" },
        { "repo": "krizaka-agents", "path": "skills/krizaka-lane-session/SKILL.md", "bump": true },
        { "repo": ".github", "path": "AGENTS.template.md" }
      ]
    },
    {
      "id": "java-norm",
      "title": "Java norm: the parent, the test support and the build rules",
      "when": [
        { "repo": "krizaka-java", "globs": ["krizaka-parent/**", "krizaka-test-support/**", "krizaka-quality/**", "krizaka-rewrite-style/**"] }
      ],
      "docs": [
        { "repo": "krizaka-java", "path": "AGENTS.md" },
        { "repo": "krizaka-java", "path": "README.md" },
        { "repo": "krizaka-agents", "path": "skills/krizaka-java/SKILL.md", "bump": true },
        { "repo": ".github", "path": "AGENTS.template.md" }
      ]
    },
    {
      "id": "typescript-norm",
      "title": "TypeScript norm: the shared lint, type and test configuration",
      "when": [{ "repo": "krizaka-ts", "globs": ["packages/config/**"] }],
      "docs": [
        { "repo": "krizaka-ts", "path": "packages/config/README.md" },
        { "repo": "krizaka-agents", "path": "skills/krizaka-typescript/SKILL.md", "bump": true },
        { "repo": ".github", "path": "AGENTS.template.md" }
      ]
    },
    {
      "id": "new-repository",
      "title": "A new or renamed repository",
      "when": [{ "repo": ".github", "globs": ["repos.json"] }],
      "docs": [
        { "repo": ".github", "path": "profile/README.md" },
        { "repo": ".github", "path": "docs/standards/repositories.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/with-claude-code.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/with-claude-code.fr.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/without-claude-code.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/without-claude-code.fr.md" }
      ]
    },
    {
      "id": "product-rename",
      "title": "A product rename or a new domain",
      "when": [
        { "repo": "krizaka-ts", "globs": ["packages/org/**"] },
        { "repo": ".github", "globs": ["docs/standards/renames-*.md"] }
      ],
      "docs": [
        { "repo": "krizaka-com", "path": "AGENTS.md" },
        { "repo": ".github", "path": "profile/README.md" },
        { "repo": ".github", "path": "docs/standards/renames-2026-11-06.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/with-claude-code.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/with-claude-code.fr.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/without-claude-code.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/without-claude-code.fr.md" }
      ]
    },
    {
      "id": "automation",
      "title": "A new automation: a cron, a hook, a script or a workflow",
      "when": [
        { "repo": "krizaka-agents", "globs": ["tools/install.json", "tools/githooks/**"] },
        { "repo": ".github", "globs": [".github/workflows/**", "actions/**", "scripts/**", "tools/**"] }
      ],
      "docs": [
        { "repo": "krizaka-agents", "path": "README.md" },
        { "repo": ".github", "path": "docs/standards/guards.md" },
        { "repo": ".github", "path": "docs/standards/automation-catalogue.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/with-claude-code.md" },
        { "local": true, "path": "cockpit: the « Automatismes » view (krizaka-internal#2755)" }
      ]
    },
    {
      "id": "release-process",
      "title": "The release process: release-please, release workflows, version bumps",
      "when": [
        { "repo": ".github", "globs": ["release-repos.json", ".github/workflows/bump-krizaka.yml", "scripts/krizaka-release.mjs", "scripts/gen-release-consumers.mjs"] }
      ],
      "docs": [
        { "repo": ".github", "path": "docs/standards/ci-and-deploy.md" },
        { "repo": "krizaka-agents", "path": "skills/krizaka-landing/SKILL.md", "bump": true }
      ]
    },
    {
      "id": "board-lanes",
      "title": "The board, the lanes and the issue statuses",
      "when": [
        { "repo": "krizaka-agents", "globs": ["tools/lanes/**", "tools/board-*.py", "tools/kz.py"] },
        { "repo": ".github", "globs": ["LABELS.md"] }
      ],
      "docs": [
        { "repo": "krizaka-agents", "path": "skills/krizaka-lane-session/SKILL.md", "bump": true },
        { "repo": "krizaka-agents", "path": "skills/krizaka-issue/SKILL.md", "bump": true },
        { "repo": ".github", "path": "LABELS.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/with-claude-code.md" },
        { "repo": "krizaka-internal", "path": "docs/onboarding/with-claude-code.fr.md" }
      ]
    },
    {
      "id": "org-policy",
      "title": "The org policy: policy.json, its schema and its readers",
      "when": [
        { "repo": ".github", "globs": ["policy.json", "docs/standards/policy.schema.json", "scripts/policy.mjs", "scripts/pr-cap.mjs"] },
        { "repo": "krizaka-agents", "globs": ["tools/policy.py"] }
      ],
      "docs": [
        { "repo": ".github", "path": "docs/standards/policy.md" }
      ]
    }
  ]
}
